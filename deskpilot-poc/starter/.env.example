# Copy this file to .env and fill in your own values. Never commit .env.

# Foundry project endpoint (used by agents). Foundry Toolkit in VS Code:
# right-click your project > Copy Project Endpoint. Or Foundry portal > project home.
PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Azure OpenAI endpoint (used for plain model calls). Foundry portal > project home.
# Use the Azure OpenAI endpoint, NOT the project endpoint.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/

# Deployment name of the chat model you chose in step 1.2
MODEL_DEPLOYMENT=gpt-5

# Step 1.2: deployments to compare, comma separated (use your own deployment names)
MODEL_DEPLOYMENTS=gpt-5,gpt-5-mini

# Agent names. The knowledge agent is created in the portal (step 2.1).
KNOWLEDGE_AGENT_NAME=deskpilot-knowledge
TICKET_AGENT_NAME=deskpilot-ticket
TRIAGE_AGENT_NAME=deskpilot-triage

# Optional (step 1.4): name of your custom guardrail, applied to agents created by code
RAI_POLICY_NAME=
